{"entryType": "UniProtKB unreviewed (TrEMBL)", "primaryAccession": "F4BX30", "uniProtkbId": "F4BX30_METSG", "entryAudit": {"firstPublicDate": "2011-06-28", "lastAnnotationUpdateDate": "2025-06-18", "lastSequenceUpdateDate": "2011-06-28", "entryVersion": 74, "sequenceVersion": 1}, "annotationScore": 3.0, "organism": {"scientificName": "Methanothrix soehngenii (strain ATCC 5969 / DSM 3671 / JCM 10134 / NBRC 103675 / OCM 69 / GP-6)", "commonName": "Methanosaeta concilii", "taxonId": 990316, "evidences": [{"evidenceCode": "ECO:0000313", "source": "EMBL", "id": "AEB67420.1"}, {"evidenceCode": "ECO:0000313", "source": "Proteomes", "id": "UP000007807"}], "lineage": ["Archaea", "Methanobacteriati", "Methanobacteriota", "Stenosarchaea group", "Methanomicrobia", "Methanotrichales", "Methanotrichaceae", "Methanothrix"]}, "proteinExistence": "3: Inferred from homology", "proteinDescription": {"recommendedName": {"fullName": {"evidences": [{"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "value": "Proteasome-activating nucleotidase"}, "shortNames": [{"evidences": [{"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "value": "PAN"}]}, "alternativeNames": [{"fullName": {"evidences": [{"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "value": "Proteasomal ATPase"}}, {"fullName": {"evidences": [{"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "value": "Proteasome regulatory ATPase"}}, {"fullName": {"evidences": [{"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "value": "Proteasome regulatory particle"}}]}, "genes": [{"geneName": {"evidences": [{"evidenceCode": "ECO:0000313", "source": "EMBL", "id": "AEB67420.1"}], "value": "panA"}, "synonyms": [{"evidences": [{"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "value": "pan"}], "orderedLocusNames": [{"evidences": [{"evidenceCode": "ECO:0000313", "source": "EMBL", "id": "AEB67420.1"}], "value": "MCON_0587"}]}], "comments": [{"texts": [{"evidences": [{"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "value": "ATPase which is responsible for recognizing, binding, unfolding and translocation of substrate proteins into the archaeal 20S proteasome core particle. Is essential for opening the gate of the 20S proteasome via an interaction with its C-terminus, thereby allowing substrate entry and access to the site of proteolysis. Thus, the C-termini of the proteasomal ATPase function like a 'key in a lock' to induce gate opening and therefore regulate proteolysis. Unfolding activity requires energy from ATP hydrolysis, whereas ATP binding alone promotes ATPase-20S proteasome association which triggers gate opening, and supports translocation of unfolded substrates"}], "commentType": "FUNCTION"}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "value": "Homohexamer. The hexameric complex has a two-ring architecture resembling a top hat that caps the 20S proteasome core at one or both ends. Upon ATP-binding, the C-terminus of PAN interacts with the alpha-rings of the proteasome core by binding to the intersubunit pockets"}], "commentType": "SUBUNIT"}, {"commentType": "SUBCELLULAR LOCATION", "subcellularLocations": [{"location": {"evidences": [{"evidenceCode": "ECO:0000256", "source": "ARBA", "id": "ARBA00004496"}, {"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "value": "Cytoplasm", "id": "SL-0086"}}]}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "value": "Consists of three main regions, an N-terminal coiled-coil domain that may assist in substrate recognition, an interdomain involved in PAN hexamerization, and a C-terminal ATPase domain of the AAA type"}], "commentType": "DOMAIN"}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000256", "source": "ARBA", "id": "ARBA00006914"}, {"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}, {"evidenceCode": "ECO:0000256", "source": "RuleBase", "id": "RU003651"}], "value": "Belongs to the AAA ATPase family"}], "commentType": "SIMILARITY"}, {"texts": [{"evidences": [{"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "value": "Lacks conserved residue(s) required for the propagation of feature annotation"}], "commentType": "CAUTION"}], "features": [{"type": "Domain", "location": {"start": {"value": 184, "modifier": "EXACT"}, "end": {"value": 323, "modifier": "EXACT"}}, "description": "AAA+ ATPase", "evidences": [{"evidenceCode": "ECO:0000259", "source": "SMART", "id": "SM00382"}]}, {"type": "Coiled coil", "location": {"start": {"value": 24, "modifier": "EXACT"}, "end": {"value": 72, "modifier": "EXACT"}}, "description": "", "evidences": [{"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}]}, {"type": "Binding site", "location": {"start": {"value": 334, "modifier": "EXACT"}, "end": {"value": 334, "modifier": "EXACT"}}, "description": "", "featureCrossReferences": [{"database": "ChEBI", "id": "CHEBI:30616"}], "evidences": [{"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "ligand": {"name": "ATP", "id": "ChEBI:CHEBI:30616"}}], "keywords": [{"evidences": [{"evidenceCode": "ECO:0000256", "source": "ARBA", "id": "ARBA00022840"}, {"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "id": "KW-0067", "category": "Ligand", "name": "ATP-binding"}, {"evidences": [{"evidenceCode": "ECO:0000256", "source": "ARBA", "id": "ARBA00023186"}, {"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "id": "KW-0143", "category": "Molecular function", "name": "Chaperone"}, {"evidences": [{"evidenceCode": "ECO:0000256", "source": "ARBA", "id": "ARBA00023054"}, {"evidenceCode": "ECO:0000256", "source": "HAMAP-Rule", "id": "MF_00553"}], "id": "KW-0175", "category": "Domain", "name": "Coiled coil"}, {"ev